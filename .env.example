# Copy to .env and fill in real values before `docker compose up`.
# Postgres/Redis/RabbitMQ/MinIO/Mongo credentials are NOT here — they're the existing
# local-dev-only defaults baked into docker/docker-compose.dev.yml (platform/platform,
# guest/guest, etc.), fine for local Docker Compose, not meant for a real deployment.

# --- data persistence ---
# Every database's data lives under this ONE directory as plain bind-mounted files (see
# docker/docker-compose.dev.yml), not opaque Docker named volumes — so the whole dataset
# is a normal directory tree you can rsync/tar/copy straight off the server if you ever
# need to migrate to a different one. Local dev default (unset): ../data relative to
# docker/docker-compose.dev.yml, i.e. <repo-root>/data. Any real deployment should set an
# ABSOLUTE path instead, e.g.:
# DATA_DIR=/opt/grammarcetamol/data       (production)
# DATA_DIR=/opt/grammarcetamol-dev/data   (development)

# --- image source (same docker-compose.yml works locally and on a cloud server) ---
# Local dev (default): leave all three unset/commented. IMAGE_PULL_POLICY defaults to
# "build", which never attempts a registry pull — it just builds from the Dockerfiles.
#
# Cloud server (see README.md's "Deploying to a cloud server" section): set IMAGE_PREFIX
# and IMAGE_PULL_POLICY=always ONCE, by hand, in the server's own .env — the automated
# deploy pipeline (.github/workflows/ci-cd.yml's `deploy` job / Jenkinsfile's "Deploy"
# stage) only ever overrides IMAGE_TAG per-deploy (to that push's commit SHA), it never
# writes IMAGE_PREFIX/IMAGE_PULL_POLICY, so don't leave them commented out on a server:
#   IMAGE_PREFIX=sodmod1999/grammarcetamol-
#   IMAGE_PULL_POLICY=always
#   (no IMAGE_TAG here — the deploy script passes it per-run: deploy.sh <commit-sha>)
# IMAGE_PREFIX=grammarcetamol/
# IMAGE_TAG=local
# IMAGE_PULL_POLICY=build

# --- nginx / TLS / domains (cloud server only — see README.md's "Deploying to a cloud
# server" section for the full one-time bootstrap: pointing DNS, running certbot
# --standalone for the first certificate, then bringing nginx up) ---
# Local dev: leave COMPOSE_PROFILES unset. nginx/certbot are gated behind Compose's
# "proxy" profile specifically so plain local dev (`docker compose up -d`, no domain, no
# TLS) never touches them — you just hit gateway:9000 / student-frontend:3000 /
# admin-frontend:3001 directly, exactly as before nginx existed.
# Cloud server (production environment): set all four. DOMAIN_APP is the BARE root
# domain here (student frontend lives at the apex, not a subdomain) — DOMAIN_ADMIN/
# DOMAIN_API are still subdomains.
# COMPOSE_PROFILES=proxy
# DOMAIN_APP=yourdomain.com
# DOMAIN_ADMIN=admin.yourdomain.com
# DOMAIN_API=api.yourdomain.com
# CERTBOT_EMAIL=you@yourdomain.com
#
# Only relevant in the production environment's .env, and only once a development
# environment is ALSO deployed to this same server (see README.md's "Serving the
# development domains through the same nginx" section) — production's nginx is the only
# one that ever binds 80/443, so it's also what serves development's public domains,
# proxying to development's published host ports. Leave unset if you're not running a
# second environment on this host. DEV_*_HOST_PORT must match whatever GATEWAY_HOST_PORT/
# STUDENT_HOST_PORT/ADMIN_HOST_PORT the development environment's OWN .env actually uses.
# DOMAIN_APP_DEV=dev.yourdomain.com
# DOMAIN_ADMIN_DEV=admin-dev.yourdomain.com
# DOMAIN_API_DEV=api-dev.yourdomain.com
# DEV_GATEWAY_HOST_PORT=9100
# DEV_STUDENT_HOST_PORT=3100
# DEV_ADMIN_HOST_PORT=3101

# --- CORS (gateway-service) ---
# Comma-separated list of origins allowed to call the API with credentials — must be the
# exact scheme+host(+port) the student/admin frontends are actually served from. Defaults
# to both frontends' plain local-dev origins when unset. Production: the two DOMAIN_APP/
# DOMAIN_ADMIN values above, with https://. Development (if running a second environment):
# its own two domains instead.
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

# --- auth-service ---
SUPER_ADMIN_EMAIL=admin@grammarcetamol.com
SUPER_ADMIN_PASSWORD=ChangeMe123!
STUDENT_FRONTEND_URL=http://localhost:3000

# --- gateway-service ---
# Shared secret Java services trust for internal-only calls (e.g. course-service's
# internal endpoints). Change this for anything beyond local dev.
INTERNAL_TOKEN=dev-internal-secret-change-in-prod

# --- payment-service (Paystack) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- notification-service (email) ---
# EMAIL_PROVIDER=log just logs emails instead of sending them — fine until you have
# real SMTP credentials.
EMAIL_PROVIDER=log
# ONE real mailbox login (most hosts only allow one on a basic plan) — SMTP_USERNAME/
# SMTP_PASSWORD authenticate as this account regardless of which "From" address a given
# email actually uses below.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# The "From" address/name most emails use — typically a domain alias (e.g. support@yourdomain.com)
# routed into the real mailbox above by your host's mail panel, not the literal login itself.
# Leave SMTP_FROM_ADDRESS blank to just use SMTP_USERNAME as the From address.
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Grammarcetamol

# Payment/purchase/subscription templates send with this "From" instead — again just an
# alias on the SAME login above, not a separate credential (most cPanel/Exim-style mail
# hosts accept any "From" address belonging to the authenticated account's own domain).
# Leave blank to fall back to SMTP_FROM_ADDRESS/SMTP_FROM_NAME above.
SMTP_BILLING_FROM_ADDRESS=
SMTP_BILLING_FROM_NAME=

# --- live-class-service (Jitsi) ---
# meet.jit.si is Jitsi's own free public instance — fine for dev/testing, not meant for
# real production load. Point this at a self-hosted Jitsi domain for a real deployment.
JITSI_DOMAIN=meet.jit.si

# --- service-to-service URLs ---
# All default to http://<container-name>:<port>, which is correct for this compose
# file's own Docker network (container-name DNS) — leave unset unless a service needs to
# be reached somewhere other than its normal container (e.g. pointing at a different
# host during a partial migration, or a non-Compose deployment). Uses the SAME override
# pattern as everything else here: unset = compose file default, set = your value wins.
# AUTH_SERVICE_URL=http://auth-service:9001
# COURSE_SERVICE_URL=http://course-service:9002
# ENROLLMENT_SERVICE_URL=http://enrollment-service:9003
# REVIEW_SERVICE_URL=http://review-service:9004
# PAYMENT_SERVICE_URL=http://payment-service:9005
# UPLOAD_SERVICE_URL=http://upload-service:9006
# NOTIFICATION_SERVICE_URL=http://notification-service:9008
# LIVE_CLASS_SERVICE_URL=http://live-class-service:9007
# AUTH_GRPC_HOST=auth-service
# AUTH_GRPC_PORT=9091

# --- running a second environment on the same server ---
# Only needed if you're deploying more than one environment (e.g. production +
# development) to the SAME host, each in its own directory — see README.md's
# "Deploying a second environment to the same server" section. Every value below has a
# default that reproduces this project's original single-environment behavior exactly, so
# an existing production .env needs none of this — it's additive, not a breaking change.
#
# COMPOSE_PROJECT_NAME namespaces every container, network, and volume this compose file
# creates, so two environments never collide by name. CONTAINER_PREFIX only affects the
# handful of services with an explicit container_name (gateway, both frontends, nginx,
# certbot — see docker-compose.yml); everything else is already namespaced by
# COMPOSE_PROJECT_NAME alone. The *_HOST_PORT vars only need to change for services that
# bind a host port at all (most backend services don't — see docker-compose.yml's own
# comment on auth-service).
# COMPOSE_PROJECT_NAME=grammarcetamol-dev
# CONTAINER_PREFIX=grammarcetamol-dev
# GATEWAY_HOST_PORT=9100
# STUDENT_HOST_PORT=3100
# ADMIN_HOST_PORT=3101
# POSTGRES_HOST_PORT=9109
# REDIS_HOST_PORT=9110
# RABBITMQ_HOST_PORT=9111
# RABBITMQ_MGMT_HOST_PORT=9112
# MINIO_API_HOST_PORT=9113
# MINIO_CONSOLE_HOST_PORT=9114
# MONGO_HOST_PORT=9115

# --- frontends (student + admin) ---
# Baked into the frontend bundles AT BUILD TIME (Next.js NEXT_PUBLIC_* inlining) — changing
# this after `docker compose build` requires a rebuild, not just a container restart.
# Local dev: leave as-is. Cloud server (behind nginx/TLS): set to
# https://api.yourdomain.com — the same value as DOMAIN_API above, with the scheme.
#
# IMPORTANT for CI-built images specifically (ci-cd.yml's `build-and-push` job): this .env
# value is NOT what the CI-built image actually gets — deploy.sh only ever pulls pre-built
# images, it never runs `docker compose build` on the server. What CI actually bakes in
# comes from the `NEXT_PUBLIC_API_URL` GitHub Environment VARIABLE (Settings ->
# Environments -> production/development -> Environment variables, not a secret — it's a
# public URL) — set that too, to the same value, or every CI-built frontend image falls
# back to the Dockerfile's own http://localhost:9000 default.
NEXT_PUBLIC_API_URL=http://localhost:9000

