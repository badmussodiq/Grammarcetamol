# Copy to .env (gitignored via backend/**/.env) and fill in real values for local dev.

PORT=9007

MONGO_HOST=localhost
MONGO_PORT=9015
MONGO_USERNAME=platform
MONGO_PASSWORD=platform12345
MONGO_DB_NAME=liveclass_db

RABBITMQ_HOST=localhost
RABBITMQ_PORT=9011
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

AUTH_SERVICE_URL=http://localhost:9001
PAYMENT_SERVICE_URL=http://localhost:9005

# meet.jit.si — free public Jitsi server, no credentials needed for the room-name-based join
# flow this service uses. See src/providers/jitsi.provider.ts.
JITSI_DOMAIN=meet.jit.si
