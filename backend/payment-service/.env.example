# Copy to .env (gitignored via backend/**/.env) and fill in real values for local dev.

PORT=9005

DB_HOST=localhost
DB_PORT=9009
DB_USERNAME=platform
DB_PASSWORD=platform

RABBITMQ_HOST=localhost
RABBITMQ_PORT=9011
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

COURSE_SERVICE_URL=http://localhost:9002
AUTH_SERVICE_URL=http://localhost:9001

# Which PaymentProvider is active — see src/providers/. Only "paystack" is registered today;
# adding stripe/flutterwave later is a new provider class + registry entry, not a rewrite.
PAYMENT_GATEWAY=paystack

# Paystack test-mode keys — https://dashboard.paystack.com/#/settings/developers
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
