# Copy to .env (gitignored via backend/**/.env) and fill in real values for local dev.

PORT=8087

DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=platform
DB_PASSWORD=platform

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

COURSE_SERVICE_URL=http://localhost:8083

# Which StorageProvider new uploads go to — see src/storage/. Existing files never care about
# this; each upload_files row records its own provider forever at creation time.
STORAGE_PROVIDER=minio
STORAGE_BUCKET=course-content

# MinIO (dev) — matches docker/docker-compose.dev.yml's minio service.
MINIO_ENDPOINT=http://localhost:9002
MINIO_ACCESS_KEY=platform
MINIO_SECRET_KEY=platform12345

# Real AWS S3 — only fill these in when you actually want a second provider registered
# alongside MinIO (see StorageProviderRegistry — it auto-registers "s3" the moment
# AWS_ACCESS_KEY_ID is set). Leave blank for MinIO-only dev.
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
