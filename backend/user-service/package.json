{
  "name": "user-service",
  "version": "0.0.1",
  "description": "User profile service for Grammarcetamol",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:dev": "ts-node src/main/main.ts",
    "start:prod": "node dist/main/main.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "11.1.18",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/typeorm": "^11.0.3",
    "@nestjs/microservices": "11.1.19",
    "typeorm": "^1.1.0",
    "pg": "^8.22.0",
    "amqplib": "^2.0.1",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "class-validator": "^0.15.1",
    "class-transformer": "^0.5.1",
    "rxjs": "^7.8.2",
    "reflect-metadata": "^0.1.13"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.28",
    "@types/node": "^26.1.2",
    "@types/express": "^5.0.6",
    "@types/amqplib": "^0.10.8",
    "typescript": "^7.0.2",
    "ts-node": "^10.9.2",
    "ts-jest": "^29.4.12",
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": { "^.+\\.(t|j)s$": "ts-jest" },
    "collectCoverageFrom": ["**/*.(t|j)s"],
    "testEnvironment": "node"
  }
}
