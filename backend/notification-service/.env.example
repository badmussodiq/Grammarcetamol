# Copy to .env (gitignored via backend/**/.env) and fill in real values for local dev.

PORT=9008

MONGO_HOST=localhost
MONGO_PORT=9015
MONGO_USERNAME=platform
MONGO_PASSWORD=platform12345
MONGO_DB_NAME=notification_db

RABBITMQ_HOST=localhost
RABBITMQ_PORT=9011
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Which EmailProvider is active — see src/providers/. "log" (the default if unset) just logs
# what would be sent, no real credentials needed; "smtp" sends real email via nodemailer.
EMAIL_PROVIDER=log

# Only needed when EMAIL_PROVIDER=smtp. Gmail example below (use an App Password, not your
# real account password — https://myaccount.google.com/apppasswords). Swapping to another SMTP
# provider (SendGrid, SES, Mailgun, etc.) later is just changing these values, same provider
# class — or adding a real SendGridProvider/SesProvider class + registry entry if you want a
# native API integration instead of SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=Grammarcetamol
