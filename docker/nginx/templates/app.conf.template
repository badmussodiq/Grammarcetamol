# ${DOMAIN_APP} -> student-frontend. See api.conf.template for why proxy_pass uses a
# resolved variable instead of a bare hostname, and 00-rate-limit.conf.template for the
# shared `resolver` directive this relies on.

server {
    listen 80;
    server_name ${DOMAIN_APP};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN_APP};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN_APP}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_APP}/privkey.pem;

    location / {
        limit_req zone=general_limit burst=40 nodelay;
        limit_conn general_conn 20;

        set $upstream http://student-frontend:3000;
        proxy_pass $upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
