# ${DOMAIN_ADMIN_DEV} -> the development stack's admin-frontend. See dev-app.conf.template
# for the full explanation of host.docker.internal routing and why this directory isn't
# mounted by default.

server {
    listen 80;
    server_name ${DOMAIN_ADMIN_DEV};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN_ADMIN_DEV};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN_ADMIN_DEV}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_ADMIN_DEV}/privkey.pem;

    location / {
        limit_req zone=general_limit burst=40 nodelay;
        limit_conn general_conn 20;

        set $upstream http://host.docker.internal:${DEV_ADMIN_HOST_PORT};
        proxy_pass $upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
